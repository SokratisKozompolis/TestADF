{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "my-demo-adf-dev"
		},
		"Oracle1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Oracle1'"
		},
		"OracleTest_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'OracleTest'"
		},
		"Oracle1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"Oracle1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "system"
		},
		"OracleTest_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"OracleTest_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "system"
		},
		"RestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.football-data.org/v4/competitions/2002"
		},
		"HourlyTrigger_properties_pipeline_parameters_TableList": {
			"type": "array",
			"defaultValue": [
				"Test1",
				"Test2",
				"Test3",
				"Test4"
			]
		},
		"HourlyTrigger_properties_pipeline_parameters_WindowStart": {
			"type": "string",
			"defaultValue": "@trigger().startTime"
		},
		"HourlyTrigger_properties_pipeline_parameters_WindowEnd": {
			"type": "string",
			"defaultValue": "@trigger().endTime"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Parquet_dataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "adls_ls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(dataset().name,'.parquet')",
							"type": "Expression"
						},
						"folderPath": "input_folder",
						"fileSystem": "mycontainer"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/fact_Parquet_dataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "adls_ls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(dataset().name,'.parquet')",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat('fact_input_folder/', formatDateTime(utcnow(), 'yyyy-MM-dd'))",
							"type": "Expression"
						},
						"fileSystem": "mycontainer"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/fact_json_api_output')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "adls_ls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(dataset().name,'.json')",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat('fact_input_folder/', formatDateTime(utcnow(), 'yyyy-MM-dd'))\n",
							"type": "Expression"
						},
						"fileSystem": "mycontainer"
					}
				},
				"schema": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/json_api_output')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "adls_ls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(dataset().name,'.json')",
							"type": "Expression"
						},
						"folderPath": "input_folder",
						"fileSystem": "mycontainer"
					}
				},
				"schema": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Oracle1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "Oracle",
				"version": "2.0",
				"typeProperties": {
					"server": "[parameters('Oracle1_properties_typeProperties_server')]",
					"authenticationType": "Basic",
					"username": "[parameters('Oracle1_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('Oracle1_password')]"
					}
				},
				"connectVia": {
					"referenceName": "integrationRuntimeSK",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/OracleTest')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "Oracle",
				"version": "2.0",
				"typeProperties": {
					"server": "[parameters('OracleTest_properties_typeProperties_server')]",
					"authenticationType": "Basic",
					"username": "[parameters('OracleTest_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('OracleTest_password')]"
					}
				},
				"connectVia": {
					"referenceName": "integrationRuntimeSK",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/RestService1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "RestService",
				"typeProperties": {
					"url": "[parameters('RestService1_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous",
					"authHeaders": {
						"X-Auth-Token": {
							"type": "AzureKeyVaultSecret",
							"store": {
								"referenceName": "api_keyvault_ls",
								"type": "LinkedServiceReference"
							},
							"secretName": "football-api"
						}
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/OracleTableTest')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "OracleTest",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					},
					"schemaName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "OracleTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().schemaName",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().tableName\n",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/OracleTest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/rest_api_dataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "RestService1",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"par_api": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "@concat('https://api.football-data.org/v4/competitions/',dataset().par_api,'/matches')",
						"type": "Expression"
					}
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/RestService1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DelimitedTextOracle",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "Parquet1",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/OracleBlob')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEachTable",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.TableList\n",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 4,
							"activities": [
								{
									"name": "CopyRaw_copy1",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "OracleSource",
											"oracleReaderQuery": {
												"value": "SELECT * FROM C##TESTUSER.TEST4\nWHERE Timestamp >= TO_TIMESTAMP('@{pipeline().parameters.WindowStart}', 'YYYY-MM-DD HH24:MI:SS.FF3')\nAND Timestamp < TO_TIMESTAMP('@{pipeline().parameters.WindowEnd}', 'YYYY-MM-DD HH24:MI:SS.FF3')\n\n",
												"type": "Expression"
											},
											"partitionOption": "None",
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobStorageWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": true,
										"stagingSettings": {
											"linkedServiceName": {
												"referenceName": "BlobForDatabricks",
												"type": "LinkedServiceReference"
											},
											"path": "test/LogStaging"
										},
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "OracleTableTest",
											"type": "DatasetReference",
											"parameters": {
												"tableName": {
													"value": "@item()\n",
													"type": "Expression"
												},
												"schemaName": "C##TESTUSER"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "OracleTXT",
											"type": "DatasetReference",
											"parameters": {
												"fileName": {
													"value": "@concat(item(), '_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.txt')",
													"type": "Expression"
												},
												"filePath": {
													"value": "@concat(item(), '/raws/', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.txt')\n",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "CopyLatest_copy1",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "CopyRaw_copy1",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "OracleSource",
											"partitionOption": "None",
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobStorageWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": true,
										"stagingSettings": {
											"linkedServiceName": {
												"referenceName": "BlobForDatabricks",
												"type": "LinkedServiceReference"
											},
											"path": "test"
										},
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "OracleTableTest",
											"type": "DatasetReference",
											"parameters": {
												"tableName": {
													"value": "@item()",
													"type": "Expression"
												},
												"schemaName": "C##TESTUSER"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "OracleTXT",
											"type": "DatasetReference",
											"parameters": {
												"fileName": {
													"value": "@{item()}.txt",
													"type": "Expression"
												},
												"filePath": {
													"value": "@concat(item(), '/latest/', item(), '.txt')",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"TableList": {
						"type": "array",
						"defaultValue": [
							"TEST1",
							"TEST2",
							"TEST3",
							"TEST4"
						]
					},
					"WindowStart": {
						"type": "string",
						"defaultValue": "@trigger().startTime"
					},
					"WindowEnd": {
						"type": "string",
						"defaultValue": "@trigger().endTime"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/OracleTableTest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dimension_pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Api_To_ADLS",
						"type": "ForEach",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('items')",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "Retrieve_Tables",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"paginationRules": {
												"supportRFC5988": "true"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "rest_api_dataset",
											"type": "DatasetReference",
											"parameters": {
												"par_api": {
													"value": "@item()",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "json_api_output",
											"type": "DatasetReference",
											"parameters": {
												"name": {
													"value": "@item()",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					},
					{
						"name": "scorers_json_to_parquet",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Api_To_ADLS",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "[['player']['id']"
										},
										"sink": {
											"name": "player_id",
											"type": "Int32"
										}
									},
									{
										"source": {
											"path": "[['player']['firstName']"
										},
										"sink": {
											"name": "firstName",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['player']['lastName']"
										},
										"sink": {
											"name": "lastName",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['player']['dateOfBirth']"
										},
										"sink": {
											"name": "dateOfBirth",
											"type": "Date"
										}
									},
									{
										"source": {
											"path": "[['player']['nationality']"
										},
										"sink": {
											"name": "nationality",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['team']['id']"
										},
										"sink": {
											"name": "team_id",
											"type": "Int32"
										}
									},
									{
										"source": {
											"path": "$['competition']['name']"
										},
										"sink": {
											"name": "competition_name",
											"type": "String"
										}
									}
								],
								"collectionReference": "$['scorers']"
							}
						},
						"inputs": [
							{
								"referenceName": "json_api_output",
								"type": "DatasetReference",
								"parameters": {
									"name": "scorers"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "Parquet_dataset",
								"type": "DatasetReference",
								"parameters": {
									"name": "scorers"
								}
							}
						]
					},
					{
						"name": "teams_json_to_parquet",
						"type": "Copy",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
