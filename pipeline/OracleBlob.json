{
	"name": "OracleBlob",
	"properties": {
		"activities": [
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.TableList\n",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 4,
					"activities": [
						{
							"name": "CopyRaw_copy1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"oracleReaderQuery": {
										"value": "@concat(\n        'SELECT * FROM C##TESTUSER.', item(), \n        ' WHERE Timestamp >= TO_TIMESTAMP(''', pipeline().parameters.WindowStart, ''', ''DD/MM/YY, HH:MI:SS AM'') ',\n        'AND Timestamp < TO_TIMESTAMP(''', pipeline().parameters.WindowEnd, ''', ''DD/MM/YY, HH:MI:SS AM'')'\n    )",
										"type": "Expression"
									},
									"partitionOption": "None",
									"queryTimeout": "02:00:00"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": true,
								"stagingSettings": {
									"linkedServiceName": {
										"referenceName": "BlobForDatabricks",
										"type": "LinkedServiceReference"
									},
									"path": "test/LogStaging"
								},
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "OracleTableTest",
									"type": "DatasetReference",
									"parameters": {
										"tableName": {
											"value": "@item()\n",
											"type": "Expression"
										},
										"schemaName": "C##TESTUSER"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "OracleTXT",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@concat(item(), '_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.txt')",
											"type": "Expression"
										},
										"filePath": {
											"value": "@concat(item(), '/raws/', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.txt')\n",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "CopyLatest_copy1",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "CopyRaw_copy1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "OracleSource",
									"partitionOption": "None",
									"queryTimeout": "02:00:00"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": true,
								"stagingSettings": {
									"linkedServiceName": {
										"referenceName": "BlobForDatabricks",
										"type": "LinkedServiceReference"
									},
									"path": "test"
								},
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "OracleTableTest",
									"type": "DatasetReference",
									"parameters": {
										"tableName": {
											"value": "@item()",
											"type": "Expression"
										},
										"schemaName": "C##TESTUSER"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "OracleTXT",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@{item()}.txt",
											"type": "Expression"
										},
										"filePath": {
											"value": "@concat(item(), '/latest/', item(), '.txt')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"TableList": {
				"type": "array",
				"defaultValue": [
					"TEST1",
					"TEST2",
					"TEST3",
					"TEST4"
				]
			},
			"WindowStart": {
				"type": "string",
				"defaultValue": "@trigger().outputs.windowStartTime"
			},
			"WindowEnd": {
				"type": "string",
				"defaultValue": "@trigger().outputs.windowEndTime"
			}
		},
		"annotations": []
	}
}